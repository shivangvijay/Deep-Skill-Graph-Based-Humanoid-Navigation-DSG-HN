<!-- G1 29-DOF scene: robot + floor, obstacles, stairs, terrain heightfields -->
<mujoco model="g1_29dof scene">
  <include file="g1_29dof.xml"/>

  <!-- NOTE: SEEMS TO WORK BETTER IF WE SIMULATE AT A FASTER FREQUENCY. SHOULD DISCUSS THIS AND OTHER CONTROL FREQUENCIES -->
  <!-- <option timestep="0.001" iterations="50" solver="Newton" integrator="implicitfast"/> -->
  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- 0.575 -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Floor -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <geom name="layout_c1_neg" type="cylinder" pos="0 -0.575 0.5" size="0.3 0.5"/>
    <geom name="layout_c2_neg" type="cylinder" pos="0 -1.675 0.5" size="0.5 0.5"/>
    <geom name="layout_c3_neg" type="cylinder" pos="0 -2.675 0.5" size="0.5 0.5"/>
    
    <geom name="layout_c1_pos" type="cylinder" pos="0 0.575 0.5" size="0.3 0.5"/> 
    <geom name="layout_c2_pos" type="cylinder" pos="0 1.675 0.5" size="0.5 0.5"/>
    <geom name="layout_c3_pos" type="cylinder" pos="0 2.675 0.5" size="0.5 0.5"/>

    <geom name="wall_north" type="box" pos="0 3.05 0.5" size="3 0.05 0.5"/>
    <geom name="wall_south" type="box" pos="0 -3.05 0.5" size="3 0.05 0.5"/>
    <geom name="wall_east"  type="box" pos="3.05 0 0.5" size="0.05 3 0.5"/>
    <geom name="wall_west"  type="box" pos="-3.05 0 0.5" size="0.05 3 0.5"/>
  </worldbody>
</mujoco>